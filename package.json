{
  "name": "@calljacob/nice-cxone-api",
  "version": "1.0.0",
  "description": "Comprehensive TypeScript API client for NICE CXone / inContact APIs",
  "keywords": [
    "api",
    "calljacob",
    "contact-center",
    "cxone",
    "incontact",
    "nice",
    "niceincontact",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "author": "Call Jacob",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "generate": "node scripts/generate-client.cjs",
    "check-types": "tsc --noEmit",
    "test": "vp test run",
    "prepublishOnly": "npm run build",
    "commitlint": "vite-plus-commitlint"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "typescript": "^6.0.3",
    "vite-plus": "^0.2.6",
    "vitest": "^4.1.10",
    "vite-plus-commitlint": "^1.1.3"
  },
  "packageManager": "pnpm@11.20.0"
}
