{
  "name": "@calljacob/nice-cxone-api",
  "version": "1.0.0",
  "description": "Comprehensive TypeScript API client for NICE CXone / inContact APIs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "generate": "node scripts/generate-client.js",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "nice",
    "cxone",
    "niceincontact",
    "incontact",
    "api",
    "sdk",
    "typescript",
    "calljacob",
    "contact-center"
  ],
  "author": "Call Jacob",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  }
}
